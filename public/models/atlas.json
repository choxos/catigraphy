      "landmarks": [
        {
          "short": "Nasal aperture",
          "name": "Bony nasal aperture",
          "note": "The opening of the nasal cavity, bounded by the incisive and nasal bones. The turbinates behind it are visible on the transverse slices and not on this surface.",
          "position": [
            -59.63,
            -1.02,
            1.21
          ],
          "snappedBy": 0.1
        },
        {
          "short": "Canine",
          "name": "Upper canine tooth",
          "note": "The longest tooth in the cat. Its root is longer than its crown and runs up into the maxilla behind the incisors.",
          "position": [
            -49.16,
            -14.09,
            14.37
          ],
          "snappedBy": 2.05
        },
        {
          "short": "Infraorbital foramen",
          "name": "Infraorbital foramen",
          "note": "The opening on the side of the maxilla in front of the orbit, carrying the infraorbital nerve and vessels to the muzzle and the whiskers.",
          "position": [
            -41,
            -3,
            19.18
          ],
          "snappedBy": 0.79
        },
        {
          "short": "Postorbital process",
          "name": "Postorbital process of the frontal bone",
          "note": "The point on the frontal bone at the back of the orbital rim. It reaches toward the matching process on the zygomatic and stops: the cat's orbit is open behind, closed in life by the orbital ligament rather than by bone, so the orbit and the temporal fossa run into one another.",
          "position": [
            -22.52,
            22.95,
            19.35
          ],
          "snappedBy": 3.95
        },
        {
          "short": "Carnassials",
          "name": "Carnassial teeth",
          "note": "The upper fourth premolar shears past the lower first molar. They are the blades of the dentition and sit where the jaw closes hardest.",
          "position": [
            -33.6,
            -14.39,
            14.92
          ],
          "snappedBy": 0.41
        },
        {
          "short": "Zygomatic arch",
          "name": "Zygomatic arch",
          "note": "The bar of zygomatic and temporal bone that bridges the orbit to the braincase. The masseter runs from its lower edge to the mandible.",
          "position": [
            -7.42,
            8.29,
            29.29
          ],
          "snappedBy": 0.91
        },
        {
          "short": "Temporal fossa",
          "name": "Temporal fossa",
          "note": "The hollow between the arch and the braincase, filled in life by the temporalis. The gap between the two is what gives the muscle room.",
          "position": [
            -2.49,
            15.62,
            18.64
          ],
          "snappedBy": 2.29
        },
        {
          "short": "Sagittal crest",
          "name": "Sagittal crest",
          "note": "The ridge along the midline of the braincase where the temporalis of each side meets its opposite. It is low in the cat and rises toward the back of the skull.",
          "position": [
            3.75,
            35.87,
            1.89
          ],
          "snappedBy": 0.81
        },
        {
          "short": "Coronoid process",
          "name": "Coronoid process of the mandible",
          "note": "The blade at the back of the mandible that rises into the temporal fossa. The temporalis inserts on it, which is why the process is as tall as the fossa is deep.",
          "position": [
            2.83,
            9.04,
            24.3
          ],
          "snappedBy": 3.61
        },
        {
          "short": "Condylar process",
          "name": "Condylar process of the mandible",
          "note": "A transverse cylinder set in a tight socket on the temporal bone. It hinges and does almost nothing else: the cat's jaw joint allows no grinding.",
          "position": [
            3.98,
            -0.95,
            24.64
          ],
          "snappedBy": 2.55
        },
        {
          "short": "Angular process",
          "name": "Angular process",
          "note": "The hook at the lower back corner of the mandible, where the digastric and part of the pterygoid attach.",
          "position": [
            21.35,
            -8.56,
            12.66
          ],
          "snappedBy": 0.17
        },
        {
          "short": "Tympanic bulla",
          "name": "Tympanic bulla",
          "note": "The rounded chamber under the back of the skull that houses the middle ear. In cats it is large and divided inside by a bony septum, which the transverse slices show.",
          "position": [
            16.37,
            -6.77,
            11.14
          ],
          "snappedBy": 3.77
        },
        {
          "short": "Occipital condyle",
          "name": "Occipital condyle",
          "note": "One of the pair that meets the atlas. Between them is the foramen magnum, and the joint they make carries the nodding of the head.",
          "position": [
            28.59,
            -5.6,
            8.36
          ],
          "snappedBy": 0.72
        },
        {
          "short": "Symphysis",
          "name": "Mandibular symphysis",
          "note": "The joint between the two halves of the mandible. In the cat it stays fibrous rather than fusing, so the two halves can move slightly against one another.",
          "position": [
            -58.03,
            -24.29,
            1.31
          ],
          "snappedBy": 0.8
        },
        {
          "short": "Atlas wing",
          "name": "Wing of the atlas",
          "note": "The broad transverse process of the first cervical vertebra. The atlas has no body and no spinous process; these wings are what you feel behind the skull.",
          "position": [
            41.11,
            -15.07,
            17.43
          ],
          "snappedBy": 0.05
        }
      ],
